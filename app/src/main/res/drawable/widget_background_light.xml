<?xml version="1.0" encoding="utf-8"?>
<!--
    Batch 583/584 — pasangan TERANG panel Neumorphism burgundy; struktur lapis & bentuk "daun diagonal"
    IDENTIK widget_background.xml (baca komentar di sana). Beda hanya nilai: kanvas perkamen hangat
    (SkeuNeuSurfaceLight 0xFFF1E8DF; sisi terang +55% putih), rim terang = putih, rim gelap = taupe hangat
