<?xml version="1.0" encoding="utf-8"?>
<!-- Batch 84/85 — lihat widget_background.xml utk alasan lengkap radial vs linear (Batch 85 fix
     "kurang depth/3D"). gradientRadius 40dp dipilih relatif thd ukuran disc (44dp) — bukan 140dp
     spt panel, biar falloff-nya proporsional ke elemen sekecil ini, bukan malah nutupin 1 sisi
     penuh. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#2FA37C" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.18"
                android:centerY="0.18"
                android:gradientRadius="40dp"
                android:startColor="#80FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.85"
                android:centerY="0.85"
                android:gradientRadius="40dp"
                android:startColor="#80000000"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
