<?xml version="1.0" encoding="utf-8"?>
<!--
    Batch 583 — MEDALI play/pause Neumorphism burgundy (pengganti disc zamrud `#2FA37C` Batch 84/85).
    Meniru medali enamel layar kunci/tombol play Now Playing (Batch 565-566): cincin GILT metalik ->
    alur ukir gelap -> cakram anggur radial (ruby terang kiri-atas -> burgundy -> anggur tergelap) ->
    sorot kaca elips -> fillet gilt tipis. Hex = token Color.kt: SkeuGilt 0xFFDCC393 / SkeuGiltDeep
    0xFF9C7E4E (ring), SkeuWineLit 0xFFA33550 / SkeuWine 0xFF6E1B30 / SkeuWineDeep 0xFF40101E (cakram).
    SATU file untuk mode gelap DAN terang (dulu 2 file): medali bukan permukaan netral — identitasnya
    anggur+gilt di kanvas apa pun, jadi pasangan `_light` dihapus (WidgetUpdater tak lagi menukar).
    Dipakai juga: tombol play bubble, bingkai sampul bubble (padding 2dp menyisakan cincin gilt),
    dan tab bubble minimized 48dp. Ukuran 36-48dp — semua inset/radius dp tetap, proporsional.
    Keadaan DITEKAN = cekung (cahaya berbalik: sisi kiri-atas gelap, kanan-bawah terang), sorot kaca
    hilang, cincin meredup — bahasa baku neumorphism. Lapis 1 gradien OPAK penuh: outline elevation
    tab minimized (8dp) diturunkan dari lapis ini; wajib tetap opak. gradientRadius dp tetap (bukan %).
    centerColor radial berada di posisi centerX (aturan GradientDrawable: stop tengah = centerX bila
    != 0.5) -> centerX 0.32 menaruh burgundy inti di 32% radius, bukan 50%.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- DITEKAN: cekung. -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="315"
                        android:startColor="#B39A68"
                        android:endColor="#6B5230" />
                </shape>
            </item>
            <item
                android:left="1.5dp"
                android:top="1.5dp"
                android:right="1.5dp"
                android:bottom="1.5dp">
                <shape android:shape="oval">
                    <solid android:color="#1E070E" />
                </shape>
            </item>
            <item
                android:left="2.25dp"
                android:top="2.25dp"
                android:right="2.25dp"
                android:bottom="2.25dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="315"
                        android:startColor="#3F0F1D"
                        android:centerColor="#5E1829"
                        android:endColor="#8A2A44" />
                </shape>
            </item>
            <item
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp">
                <shape android:shape="oval">
                    <stroke
                        android:width="0.75dp"
                        android:color="#1FDCC393" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- NORMAL: cembung. -->
    <item>
        <layer-list>
            <!-- 1. Cincin gilt metalik (opak — lihat catatan elevation). -->
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="315"
                        android:startColor="#F4E2B8"
                        android:centerColor="#C9A96F"
                        android:endColor="#8A6B3F" />
                </shape>
            </item>
            <!-- 2. Alur ukir gelap antara cincin dan cakram. -->
            <item
                android:left="1.5dp"
                android:top="1.5dp"
                android:right="1.5dp"
                android:bottom="1.5dp">
                <shape android:shape="oval">
                    <solid android:color="#2B0B14" />
                </shape>
            </item>
            <!-- 3. Cakram anggur radial, sumber cahaya kiri-atas. -->
            <item
                android:left="2.25dp"
                android:top="2.25dp"
                android:right="2.25dp"
                android:bottom="2.25dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:centerX="0.32"
                        android:centerY="0.26"
                        android:gradientRadius="38dp"
                        android:startColor="#BC4A64"
                        android:centerColor="#7A2036"
                        android:endColor="#3B0E1B" />
                </shape>
            </item>
            <!-- 4. Sorot kaca elips di separuh atas. -->
            <item
                android:left="6dp"
                android:top="3.5dp"
                android:right="6dp"
                android:height="15dp"
                android:gravity="top|fill_horizontal">
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#4DFFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <!-- 5. Fillet gilt tipis di dalam cakram. -->
            <item
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp">
                <shape android:shape="oval">
                    <stroke
                        android:width="0.75dp"
                        android:color="#2EDCC393" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
