<?xml version="1.0" encoding="utf-8"?>
<!--
    Batch 84 — dulu solid oval merah polos (#FA233B, aksen Apple-red peninggalan desain lama),
    diganti disc Neumorphism + dual-shadow bevel yang sama polanya dengan widget_background.xml
    (lihat komentar lengkap di sana), cuma shape oval bukan rectangle. Warna dasar SkeuEmerald
    (#2FA37C) — BUKAN SkeuAccent/Titanium (#B6BAC0): ic_widget_play/pause.png itu putih polos,
    kontrasnya jauh lebih jelek di atas titanium abu-terang daripada di atas emerald gelap.
    SkeuEmerald juga persis token "sedikit sentuhan zamrud" yang app pakai sebagai SATU-SATUNYA
    titik warna di tengah palet titanium netral (Color.kt baris ~237-246) — tombol play/pause
    ini kebetulan juga satu-satunya titik warna di widget yang isinya titanium-netral, jadi
    perannya sama persis dengan hero art di NowPlayingScreen.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#2FA37C" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#40000000"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
