<?xml version="1.0" encoding="utf-8"?>
<!--
    Batch 612 — GARIS TEPI PINK mengelilingi kontur daun palung (mode TERANG). Batch 611 (palung daun 20/4/20/4) dilaporkan user
    "tidak ada perubahan kasat mata": BENAR — bibir lapis-1 dulu gradien gelap -> terang diagonal (TL gelap, TR/BL separuh gelap) sehingga
    hanya BR yang terlihat; sudut yang diubah (TL/TR/BL) gelap-di-atas-gelap, selisih piksel v610->v611 hanya 0,14-0,24% area pada kontras
    terlihat. Kini lapis-1 = pink di SELURUH kontur (kiri-atas lebih redup, kanan-bawah paling terang) -> lengkung besar TL/BR dan
    ujung runcing TR/BL terbaca jelas. Hanya WARNA lapis-1 berubah; radius, lantai, band, pendar tetap Batch 611.
    Batch 611 — PALUNG cekung (TERANG), bentuk DAUN (TL 20 / TR 4 / BR 20 / BL 4; dulu 14/10/20/12 = bilah) — selaras dgn cangkang daun
    Batch 610 (TL/BR besar, TR/BL runcing). Pasangan: widget_well.xml. Radius dasar 20 pada BR TETAP (kenop next menempel 3dp dari tepi
    palung slim, celah = v609); TL naik 14 -> 20 (celah teks slim 3,2dp, compact 1,6dp, penuh 2,4dp).
    Lapis konsentris: radius = dasar - inset (lantai 1,5dp). Band bayangan dinding atas: tinggi 8 -> 19 dan pudar 3-warna selesai di
    tengah band (v609: radius band diskala Skia krn tinggi 8dp < radius TL -> baji gelap bocor di LUAR bentuk palung di sudut kiri-atas).
    Pendar bawah (rect 6dp): inset kanan 9 -> 13dp supaya ujung kanan tidak keluar dari busur BR (dulu menonjol ~3dp).
    Padding layout, ukuran palung, kenop, dan Kotlin TIDAK berubah.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315" android:startColor="#A8566F" android:centerColor="#C46A84" android:endColor="#E89AB0" />
            <corners android:topLeftRadius="20dp" android:topRightRadius="4dp" android:bottomRightRadius="20dp" android:bottomLeftRadius="4dp" />
        </shape>
    </item>
    <item android:left="1.5dp" android:top="1.5dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270" android:startColor="#CFC1B2" android:endColor="#E6DACD" />
            <corners android:topLeftRadius="18.5dp" android:topRightRadius="2.5dp" android:bottomRightRadius="18.5dp" android:bottomLeftRadius="2.5dp" />
        </shape>
    </item>
    <item android:left="1.5dp" android:top="1.5dp" android:right="1dp" android:height="19dp" android:gravity="top|fill_horizontal">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270" android:startColor="#4D000000" android:centerColor="#00000000" android:endColor="#00000000" />
            <corners android:topLeftRadius="18.5dp" android:topRightRadius="2.5dp" android:bottomRightRadius="0dp" android:bottomLeftRadius="0dp" />
        </shape>
    </item>
    <item android:left="9dp" android:right="13dp" android:bottom="2.5dp" android:height="6dp" android:gravity="bottom|fill_horizontal">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="90" android:startColor="#33A33550" android:endColor="#00A33550" />
        </shape>
    </item>
    <item android:left="12dp" android:right="12dp" android:bottom="3dp" android:height="1.5dp" android:gravity="bottom|fill_horizontal">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0" android:startColor="#00741C32" android:centerColor="#B3741C32" android:endColor="#00741C32" />
        </shape>
    </item>
</layer-list>
