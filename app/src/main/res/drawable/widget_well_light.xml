<?xml version="1.0" encoding="utf-8"?>
<!--
    Batch 604 — PALUNG cekung (mode TERANG), pasangan widget_well.xml. Perkamen: bibir gelap kiri-atas -> putih
    kanan-bawah (cahaya), lantai lebih redup dari permukaan cangkang (widget_background_light.xml), bayangan dinding
    atas 6dp, garis pendar burgundy tipis di dasar. Geometri/radius SAMA dgn pasangan gelap.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#A89A8C"
                android:centerColor="#D8CCBF"
                android:endColor="#FFFFFF" />
            <corners
                android:topLeftRadius="14dp"
                android:topRightRadius="10dp"
                android:bottomRightRadius="20dp"
                android:bottomLeftRadius="12dp" />
        </shape>
    </item>
    <item
        android:left="1.5dp"
        android:top="1.5dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#D9CDBF"
                android:endColor="#E8DDD0" />
            <corners
                android:topLeftRadius="12.5dp"
                android:topRightRadius="8.5dp"
                android:bottomRightRadius="19dp"
                android:bottomLeftRadius="10.5dp" />
        </shape>
    </item>
    <item
        android:left="1.5dp"
        android:top="1.5dp"
        android:right="1dp"
        android:height="6dp"
        android:gravity="top|fill_horizontal">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#38000000"
                android:endColor="#00000000" />
            <corners
                android:topLeftRadius="12.5dp"
                android:topRightRadius="8.5dp"
                android:bottomRightRadius="0dp"
                android:bottomLeftRadius="0dp" />
        </shape>
    </item>
    <item
        android:left="14dp"
        android:right="14dp"
        android:bottom="3dp"
        android:height="1dp"
        android:gravity="bottom|fill_horizontal">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#00741C32"
                android:centerColor="#66741C32"
                android:endColor="#00741C32" />
        </shape>
    </item>
</layer-list>
