<?xml version="1.0" encoding="utf-8"?>
<!--
    Batch 84 — redesign "Neumorphism, hardcode" (instruksi eksplisit user). Widget home-screen ini
    RemoteViews murni (bukan Compose), jadi TIDAK BISA ikut ThemeStore/pilihan Tactile-Skeu-Apple
    yang aktif di dalam app — RemoteViews cuma bisa reference id drawable resource yang sudah
    dikompilasi, tidak bisa jalanin Modifier.drawBehind() dinamis kayak skeuEmboss() di
    TactileDepth.kt. Makanya "di-hardcode": widget SELALU render gaya Neumorphism, apapun tema
    yang lagi aktif di dalam app (isDark/light MODE di WidgetUpdater.kt TIDAK diubah/dihapus —
    itu sumbu terpisah, gelap/terang, bukan pilihan Tactile/Skeu/Apple).

    Palet persis sama dengan token asli di Color.kt (bukan angka karang-karangan baru):
    - Base panel: SkeuNeuSurfaceDark (#191C21)
    - Dual-shadow diagonal: arah sama seperti skeuEmboss() — terang kiri-atas (135°) turun ke
      gelap kanan-bawah (315°), meniru cahaya-datang-dari-kiri-atas yang sama di seluruh app.
    - Alpha startColor dipilih dari sisi "far/lemah" token asli (SkeuHighlight 0.16 / mendekati
      SkeuAmbientOcclusion 0.40) bukan sisi "near/kuat" (SkeuSpecular 0.55) — gradient di sini
      menyebar ke SELURUH panel widget (jauh lebih luas dari border tipis skeuEmboss()), kalau
      pakai alpha kuat satu sudut jadi keputihan/kehitaman berlebih di widget sekecil ini.
    - 0 border/stroke sama sekali — konsisten dengan identitas Neumorphism di seluruh app
      ("TIDAK ADA border/grain sama sekali", lihat komentar Color.kt baris ~196-208).

    Belum diverifikasi visual sungguhan di device (no emulator di environment kerja).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#191C21" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#29FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#59000000"
                android:endColor="#00000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
