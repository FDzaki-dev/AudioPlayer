<?xml version="1.0" encoding="utf-8"?>
<!--
    Batch 84/85 — Neumorphism widget (lihat Batch 84 utk konteks lengkap kenapa "di-hardcode").
    Batch 85: user feedback dari screenshot device sungguhan — "kurang efek depth/3D" — 2 layer
    gradient LINEAR diagonal Batch 84 nyebar rata ke SELURUH panel, di widget sebesar ini jadi
    nyaris tak kelihatan (alpha far/lemah token asli ternyata terlalu halus utk bidang seluas
    ini, beda konteks dari border tipis skeuEmboss()). Diganti gradient RADIAL dipusatkan PERSIS
    di pojok (bukan nyebar diagonal merata) — cahaya/bayangan mengumpul di 1 titik pojok itu jauh
    lebih kebaca sebagai "sumber cahaya" drpd wash tipis merata, dan alpha dinaikkan signifikan
    (bukan lagi sisi "far" token asli — di widget ini falloff radial sendiri yang membuat area
    tetap sempit, jadi aman pakai alpha lebih tinggi tanpa banjir 1 warna). `gradientRadius` fix
    140dp (bukan persen — `%`/`%p` butuh API 29+, minSdk app ini 23), jadi proporsinya bisa
    sedikit beda di widget yang di-resize sangat kecil/besar oleh user — trade-off diterima.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#191C21" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.05"
                android:centerY="0.08"
                android:gradientRadius="140dp"
                android:startColor="#59FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.95"
                android:centerY="0.92"
                android:gradientRadius="140dp"
                android:startColor="#8C000000"
                android:endColor="#00000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Batch 207 — border tipis, murni untuk batas visual widget selalu jelas (diminta user:
         "pembatas/border visual") — bukan fungsional, tidak pengaruh ke layout/insets. -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
