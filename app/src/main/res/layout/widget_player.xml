<?xml version="1.0" encoding="utf-8"?>
<!--
    Batch 604 — STRUKTUR BERTINGKAT ala Boomly (lihat widget_player_compact.xml): keping sampul 56dp + PALUNG cekung
    (widget_well, tinggi 56dp) berisi kolom judul/artis + kontrol, di atas cangkang "bilah". Lebar tetap non-judul =
    padding 10x2 + sampul 56 + margin palung 6 + padding palung 14+6 + margin kolom 4 + prev 34 + (4+44) + (4+34) = 226dp
    (WidgetUpdater.FULL_FIXED_WIDTH_DP / FULL_PADDING_DP HARUS sama). Semua id lama dipertahankan; `widget_well` baru.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_dark"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_well"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_well"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="Tidak ada lagu">
                <requestFocus />
            </TextView>

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#98989D"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Buka SONIX" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_previous"
            android:contentDescription="Sebelumnya" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:padding="12dp"
            android:background="@drawable/widget_play_button_bg"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="Putar" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:padding="7dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="Berikutnya" />

    </LinearLayout>

</LinearLayout>
