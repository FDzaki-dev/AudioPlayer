<?xml version="1.0" encoding="utf-8"?>
<!--
    Batch 607: 3 spasi berbobot (atas / antar-baris / bawah) membagi sisa tinggi rata pada widget 124-209dp (dulu isi
    menggerombol di tengah dgn ruang kosong atas-bawah); pada 129dp sisa ~3dp -> tampilan tidak berubah. Widget >= 210dp
    memakai `widget_player_tall.xml`.
    Batch 606: + clipToPadding=false (kelebihan kecil tidak dipotong) + includeFontPadding=false pada judul/artis (font
    perangkat berjarak baris ~1,37x: judul 2 baris + artis hampir menyentuh bibir palung 62dp).
    Batch 605 — LAYOUT PENUH BERTINGKAT DUA BARIS (dulu satu baris: sampul 56 + palung 56 berisi judul + 3 kontrol).
    Akar "tidak rapi" (screenshot widget 290x129dp): isi satu baris hanya 76dp di cangkang 129dp -> ~26dp kosong
    atas & bawah, dan kolom judul tinggal ~64dp (judul "[HAR..", artis "Claw M.." terpotong) karena tiga kontrol
    berbagi baris dengan teks. Kini: baris 1 = sampul 62dp + PALUNG (widget_well, tinggi 62dp) berisi judul (maks 2
    baris) + artis selebar sisa lebar; baris 2 = kontrol prev / play / next DI TENGAH (kenop + medali di atas
    permukaan cangkang, sama dgn tampilan Batch 584-603). Tinggi isi = padding 10x2 + 62 + 4 + 40 = 126dp
    (WidgetUpdater.COMPACT_HEIGHT_THRESHOLD_DP = 124 memilih layout ini hanya bila tinggi widget >= 124dp, toleransi
    2dp dimakan padding; di bawah itu layout compact dipakai). Lebar tetap non-judul (untuk ESTIMASI log) = padding 10x2 + sampul 62 + margin
    palung 6 + padding palung 14+12 = 114dp (WidgetUpdater.FULL_FIXED_WIDTH_DP / FULL_PADDING_DP HARUS sama).
    Judul 13sp (sama dgn compact; 14sp terlalu mepet di palung 62dp pada fontScale 1.15) memakai ellipsize="end" (bukan marquee): marquee hanya jalan pada SATU baris, sedangkan judul di sini
    boleh dua baris. Semua id lama dipertahankan; `widget_well` ada di kedua layout (latar ditukar gelap/terang oleh
    WidgetUpdater).
    Batch 610: root DIBUNGKUS `FrameLayout` ber-id `@android:id/background` + `clipToOutline="true"` = opt-out resmi dari clip radius
    sudut yang dipaksakan launcher Android 12+ (Launcher3 RoundedCornerEnforcement) -> widget 46dp tidak lagi jadi PIL; bentuk daun
    digambar HANYA oleh drawable cangkang (`widget_background*`). Pembungkus tanpa latar (outline persegi, tak memotong apa pun);
    `widget_root` tetap id isi/cangkang (WidgetUpdater tak berubah).
    Batch 641 — JUDUL = `widget_title_viewport` (FrameLayout pemotong) berisi TextView `widget_title` selebar TETAP 4000dp, 1 baris, tanpa ellipsize/fokus/marquee
    bawaan (setSelected tak remotable; marquee fokus tak andal di launcher). Digeser app: WidgetMarqueeDriver mengirim `partiallyUpdateAppWidget`
    berisi margin kiri NEGATIF (WidgetMarquee.kt); update penuh selalu mengembalikan margin ke 0. Lebar tetap non-judul TIDAK berubah.
    Batch 643 — judul punya DUA tampilan di `widget_title_viewport`: `widget_title_static` (muat di kolom: 1 baris, ellipsize end) ATAU `widget_title_flipper`
    (ViewFlipper tanpa autoStart; judul tak muat: `widget_title` 4000dp berisi dua salinan teks, digeser oleh animasi segmen `@anim/widget_title_segment`
    yang digambar launcher + 1 update margin per detik dari WidgetMarqueeDriver). WidgetUpdater menampilkan salah satunya (`setViewVisibility`).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background_dark"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:clipToPadding="false"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_album_art"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:id="@+id/widget_well"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_well"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <FrameLayout
                    android:id="@+id/widget_title_viewport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/widget_title_static"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:ellipsize="end"
                        android:text="Tidak ada lagu" />

                    <ViewFlipper
                        android:id="@+id/widget_title_flipper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inAnimation="@anim/widget_title_segment"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/widget_title"
                            android:layout_width="4000dp"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:text="Tidak ada lagu" />

                    </ViewFlipper>

                </FrameLayout>

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="#98989D"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:text="Buka SONIX" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/widget_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_previous"
                android:contentDescription="Sebelumnya" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:padding="10dp"
                android:background="@drawable/widget_play_button_bg"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play"
                android:contentDescription="Putar" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="12dp"
                android:padding="7dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next"
                android:contentDescription="Berikutnya" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</FrameLayout>
