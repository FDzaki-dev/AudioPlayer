<?xml version="1.0" encoding="utf-8"?>
<!-- Roadmap #11 — Floating Mini Player. Sengaja reuse drawable widget home-screen apa adanya
     (widget_background.xml, widget_play_button_bg.xml, ic_widget_*.png) — identitas visual
     bubble & widget jadi konsisten otomatis, dan 0 asset baru perlu dibuat. Selalu varian
     GELAP (bukan widget_background_light) — bubble mengambang di atas app APAPUN termasuk yang
     bertema terang, jadi butuh 1 kontras yang konsisten & jelas terbaca di semua kondisi
     background, bukan ikut light/dark toggle in-app seperti widget.

     Batch 583 — ROMBAK Neumorphism burgundy (kontrak drawable bersama dgn widget ikut berganti, lihat
     widget_background.xml): panel = bevel anggur + hairline/border gilt; play = medali ruby bercincin
     gilt; prev/next = kenop berkedalaman (widget_key_bg, varian gelap); sampul = bingkai medali yang
     SAMA (widget_play_button_bg) dengan padding 2dp + cropToPadding sehingga cincin gilt terlihat di
     sekeliling sampul tanpa mengubah hierarki — TouchDelegate album art (Batch 470-472) menghitung
     dari `getHitRect()` view yang sama, jadi geometri sentuh tak terpengaruh. Chevron minimize
     sengaja TANPA kenop + alpha 0.72: aksi sekunder, bukan kontrol putar. Margin/ukuran disesuaikan
     agar kenop tidak berdesakan (lebar total naik ~14dp dari versi sebelumnya).
     Catatan jujur: listener sentuh setupDrag (Batch 474) mengonsumsi event pada tombol/album art,
     jadi keadaan "ditekan" (cekung) dari drawable selector TIDAK tampil di bubble — hanya di widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="9dp"
    android:elevation="8dp">

    <ImageView
        android:id="@+id/bubble_album_art"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_play_button_bg"
        android:padding="2dp"
        android:cropToPadding="true"
        android:scaleType="centerCrop"
        android:contentDescription="Sampul album" />

    <ImageButton
        android:id="@+id/bubble_prev"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:padding="7dp"
        android:background="@drawable/widget_key_bg"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_previous"
        android:contentDescription="Sebelumnya" />

    <ImageButton
        android:id="@+id/bubble_play_pause"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:padding="10dp"
        android:background="@drawable/widget_play_button_bg"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_play"
        android:contentDescription="Putar" />

    <ImageButton
        android:id="@+id/bubble_next"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="4dp"
        android:padding="7dp"
        android:background="@drawable/widget_key_bg"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_next"
        android:contentDescription="Berikutnya" />

    <!-- Batch 100 — minimize ke tepi layar (BUKAN tombol close/dismiss, lihat FloatingBubbleService
         KDoc). Ukuran hit-area disamakan 26-28dp dgn tombol lain; padding lebih besar karena glyph
         chevron lebih kecil dari ikon play/prev/next. Batch 583: tanpa kenop, alpha 0.72. -->
    <ImageButton
        android:id="@+id/bubble_minimize"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="6dp"
        android:padding="6dp"
        android:alpha="0.72"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_bubble_minimize"
        android:contentDescription="Kecilkan ke tepi layar" />

</LinearLayout>
