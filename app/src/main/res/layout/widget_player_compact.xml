<?xml version="1.0" encoding="utf-8"?>
<!--
    Batch 605 — NAPAS di dalam cangkang (user: "kurang rapi"). Struktur Batch 604 dipertahankan (keping sampul +
    PALUNG cekung `widget_well` berisi judul + kontrol, di atas cangkang "bilah"), tetapi ukurannya dilonggarkan:
    cangkang menyisakan ~5dp di tiap sisi (halo 3dp + rim 2dp), jadi padding 7dp lama hanya menyisakan ~2dp antara
    isi dan rim (sampul/palung terlihat menempel ke tepi, medali play 38dp hampir menyentuh bibir palung 44dp).
    Kini padding 9dp (~4dp napas), sampul + palung 40dp (tinggi isi 40 + 18 padding = 58dp <= tinggi minimum compact
    59dp), medali play 36dp (tepi palung 2dp) dan kenop 26dp tetap. Lebar tetap non-judul = padding 9x2 + sampul 40
    + margin palung 6 + padding palung 12+4 + (26+2) + (36+2) + (26+2) = 174dp (sama dgn Batch 604 -> kolom judul
    tak menyempit; WidgetUpdater.COMPACT_FIXED_WIDTH_DP / COMPACT_PADDING_DP HARUS sama). Semua id lama dipertahankan.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_dark"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="9dp">

    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_well"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_well"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="Tidak ada lagu">
            <requestFocus />
        </TextView>

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="2dp"
            android:padding="4dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_previous"
            android:contentDescription="Sebelumnya" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:padding="8dp"
            android:background="@drawable/widget_play_button_bg"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="Putar" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="2dp"
            android:padding="4dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="Berikutnya" />

    </LinearLayout>

</LinearLayout>
