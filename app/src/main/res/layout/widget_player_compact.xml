<?xml version="1.0" encoding="utf-8"?>
<!--
    Batch 604 — STRUKTUR BERTINGKAT ala Boomly: keping sampul (kiri) + PALUNG cekung (widget_well) berisi judul +
    kontrol, di atas cangkang "bilah" (widget_background_dark/_light). Dulu semuanya mengambang rata di satu permukaan.
    Lebar tetap non-judul = padding 7x2 + sampul 44 + margin palung 5 + padding palung 12+3 + (26+2) + (38+2) + (26+2)
    = 174dp (WidgetUpdater.COMPACT_FIXED_WIDTH_DP / COMPACT_PADDING_DP HARUS sama). Tinggi isi 44dp (+14 padding = 58dp <=
    tinggi minimum compact 59dp). Semua id lama dipertahankan; `widget_well` baru (latar ditukar gelap/terang oleh
    WidgetUpdater).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_dark"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="7dp">

    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_well"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_marginStart="5dp"
        android:background="@drawable/widget_well"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="3dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="Tidak ada lagu">
            <requestFocus />
        </TextView>

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="2dp"
            android:padding="4dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_previous"
            android:contentDescription="Sebelumnya" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:padding="9dp"
            android:background="@drawable/widget_play_button_bg"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="Putar" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="2dp"
            android:padding="4dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="Berikutnya" />

    </LinearLayout>

</LinearLayout>
