<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Batch 92 (Roadmap #9, Visualizer Audio) — required by android.media.audiofx.Visualizer
         for ANY audio session, including this app's own playback (there is no exception for
         visualizing your own audio, confirmed against the platform's own class docs). Nothing is
         actually recorded or stored: the platform only lets this app read low-quality FFT/
         waveform samples of its own currently-playing track. Declaring it here is required for
         the app to be allowed to ask; the actual runtime prompt (API 23+) only fires when the
         user explicitly turns the Visualizer on in Now Playing → Kontrol Lanjutan, never at
         first launch — see VisualizerSheet.kt / MainActivity.kt's visualizerPermissionLauncher. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Roadmap #11, Floating Mini Player — izin sensitif "gambar di atas app lain", wajib
         diminta eksplisit lewat Settings.ACTION_MANAGE_OVERLAY_PERMISSION (bukan runtime
         permission dialog biasa). Hanya diminta saat user menyalakan toggle bubble sendiri di
         Settings, sama pola on-demand seperti RECORD_AUDIO Batch 92 di atas — lihat
         FloatingBubbleService.kt / MainActivity.kt's overlayPermissionLauncher. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Batch 98 — FloatingBubbleService jadi foreground service beneran (tipe "specialUse",
         API 34+ belum punya kategori resmi utk "overlay window") supaya bertahan hidup seandal
         PlaybackService, bukan cuma "mendekati visible" seperti sebelumnya (Batch 95/97). Lihat
         FloatingBubbleService.kt untuk detail trade-off + CHANGELOG Batch 98. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Batch 98 — bubble otomatis nyala lagi setelah HP restart kalau toggle-nya sebelumnya
         ON, tanpa user harus buka app dulu. Lihat BubbleBootReceiver.kt. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".AudioPlayerApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.AudioPlayer"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowLayoutInDisplayCutoutMode="shortEdges"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Roadmap #11, Floating Mini Player. Batch 98: sekarang foreground service beneran
             (tipe "specialUse"), bukan lagi murni mengandalkan importance dari window overlay
             yang tampil. exported="false" — cuma dinyalakan dari dalam app sendiri (Settings
             toggle) atau BubbleBootReceiver (juga internal), tidak pernah komponen app lain. -->
        <service
            android:name=".bubble.FloatingBubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_bubble_mini_player" />
        </service>

        <!-- Batch 98 — restart bubble otomatis setelah reboot HP kalau togglenya sebelumnya ON
             & izin overlay masih ada, tanpa perlu user buka app dulu (sebelumnya cuma restart
             saat app dibuka manual, lihat MainActivity's LaunchedEffect). exported="false":
             sistem tetap bisa broadcast BOOT_COMPLETED ke receiver internal — atribut ini cuma
             mencegah APP LAIN memicunya secara manual. -->
        <receiver
            android:name=".bubble.BubbleBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Batch 100 (Roadmap #11 lanjutan) — Quick Settings Tile: toggle bubble langsung dari
             shade notifikasi tanpa buka app. exported="true" + permission BIND_QUICK_SETTINGS_TILE
             WAJIB persis begini (kontrak resmi API QS Tile, System UI yang bind lintas proses) —
             beda dari service internal lain di file ini yang sengaja exported="false". -->
        <service
            android:name=".bubble.BubbleTileService"
            android:exported="true"
            android:icon="@drawable/ic_bubble_tile"
            android:label="Mini Player Mengambang"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Lets Bluetooth devices and the Android System UI media-resumption feature relaunch
             this service and hand it a MEDIA_BUTTON intent even after the app process has been
             killed — required for MediaSession.Callback.onPlaybackResumption() to ever fire. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.PlayerWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_player_info" />
        </receiver>

    </application>
</manifest>
