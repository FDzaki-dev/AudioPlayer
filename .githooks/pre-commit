#!/usr/bin/env bash
# Batch 525 — pre-commit konstitusi: blokir commit cacat via detekt + lintDebug.
# OPT-IN (tidak aktif sendiri): aktifkan sekali per clone ->
#   chmod +x .githooks/pre-commit && git config core.hooksPath .githooks
# Aman utk device tanpa toolchain: kalau Gradle atau Android SDK tidak ada, hook SKIP
# (exit 0) dan penegaknya job CI `static-analysis` — supaya commit Termux tidak macet.
# Kalau toolchain ada: gagal = commit DIBLOKIR.

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

if [ -x ./gradlew ]; then
  GRADLE="./gradlew"
elif command -v gradle >/dev/null 2>&1; then
  # Proyek belum punya Gradle Wrapper (gap list #19) -> fallback ke `gradle` di PATH.
  GRADLE="gradle"
else
  echo "[pre-commit] SKIP: gradle/gradlew tidak ditemukan — penegak = job CI static-analysis." >&2
  exit 0
fi

if [ -z "${ANDROID_HOME:-}" ] && [ -z "${ANDROID_SDK_ROOT:-}" ] && [ ! -f local.properties ]; then
  echo "[pre-commit] SKIP: Android SDK tidak terdeteksi — penegak = job CI static-analysis." >&2
  exit 0
fi

BEFORE="$(git diff | md5sum)"

"$GRADLE" detekt lintDebug --console=plain || {
  echo "[pre-commit] DIBLOKIR: detekt/lintDebug gagal — commit dibatalkan." >&2
  exit 1
}

# detekt autoCorrect:true menulis perbaikan ke working tree. Perbaikan itu BELUM ada di index
# commit ini -> blokir supaya user me-review `git diff` dan stage ulang, bukan commit diam-diam.
AFTER="$(git diff | md5sum)"
if [ "$BEFORE" != "$AFTER" ]; then
  echo "[pre-commit] DIBLOKIR: detekt autoCorrect mengubah file. Review git diff, git add ulang, commit lagi." >&2
  exit 1
fi

exit 0
